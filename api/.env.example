NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Comma-separated list of sites allowed to call the API from a browser. HTTPS only in production.
ALLOWED_ORIGINS=https://nama.example
# Set to true only when running behind a load balancer / CDN you control, so client IPs are read correctly.
TRUST_PROXY=true
# At least 16 random characters. Used to hash visitor IPs before they are logged.
IP_HASH_SALT=change-me-to-a-long-random-string
# Optional. Without it, /api/ask answers with retrieval only (no model call).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=8000
# Optional: USD per million tokens, used to record cost per query in traces.
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
TRACE_FILE=traces.jsonl
